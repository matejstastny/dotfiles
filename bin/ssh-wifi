#!/bin/bash
# Share Mac WiFi with Jetson Xavier over USB (192.168.55.x network)
set -e

echo "Enabling IP forwarding..."
sudo sysctl -w net.inet.ip.forwarding=1

echo "Loading NAT rule for Xavier subnet..."
echo "nat on en0 from 192.168.55.0/24 to any -> (en0)" | sudo pfctl -a "com.apple/jetson-usb" -N -f -

echo "Enabling pf firewall..."
sudo pfctl -E

echo "Done. Xavier (192.168.55.1) can now reach the internet through your Mac's WiFi."
echo "To make this persist across reboots, re-run this script after each Mac restart."
