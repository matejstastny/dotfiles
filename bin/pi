#!/usr/bin/env python3
#@ manage raspberry pis over tailscale

import os
import re
import shlex
import shutil
import subprocess
import sys
import tarfile
import tempfile
from pathlib import Path

_ROOT = Path(__file__).resolve().parent.parent
PI_DIR = _ROOT / "pi"
HOSTS_FILE = Path(os.environ.get("REMOTE_HOSTS_CONFIG", Path.home() / ".config/remote/hosts.toml"))
CONNECT_TIMEOUT = 10

PULLABLE = {
    "thebe": {
        "/var/lib/adguardhome/AdGuardHome.yaml": "AdGuardHome.yaml",
        "/etc/ntfy/server.yml": "ntfy-server.yml",
    },
    "leda": {
        "/var/lib/adguardhome/AdGuardHome.yaml": "AdGuardHome.yaml",
    },
}

SSH_OPTS = [
    "-o", f"ConnectTimeout={CONNECT_TIMEOUT}",
    "-o", "StrictHostKeyChecking=accept-new",
    "-o", "BatchMode=no",
    "-o", "LogLevel=ERROR",
]


def parser() -> "argparse.ArgumentParser":
    import argparse

    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("hosts", nargs="*", metavar="HOST", help="host names (default: all)")
    common.add_argument("--host", action="append", dest="host_flags", metavar="HOST", help="select a host (may be repeated)")

    p = argparse.ArgumentParser(
        prog="pi",
        description="Manage the Raspberry Pis in pi/ over Tailscale.",
        epilog="Examples:\n  pi sync io --services\n  pi ping\n  pi ip thebe\n  pi reboot leda\n  pi ssh io 'journalctl -u caddy'",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument("-V", "--version", action="version", version="pi 1.0")
    commands = p.add_subparsers(dest="command", metavar="COMMAND")

    sync = commands.add_parser("sync", parents=[common], help="push config to hosts")
    sync.add_argument("-n", "--dry-run", action="store_true", help="show files and actions without changing hosts")
    sync.add_argument("-b", "--bootstrap", action="store_true", help="also run the host bootstrap script")
    sync.add_argument("-s", "--services", action="store_true", help="build and install host services")

    fetch = commands.add_parser("fetch", aliases=["pull"], parents=[common], help="fetch tracked service configs from hosts")
    fetch.add_argument("-n", "--dry-run", action="store_true", help="show files without writing them")

    commands.add_parser("ping", parents=[common], help="ping hosts over the network")
    commands.add_parser("ip", parents=[common], help="show each host's local IP addresses")
    reboot = commands.add_parser("reboot", parents=[common], help="reboot hosts")
    reboot.add_argument("--all", action="store_true", help="reboot every host")

    ssh = commands.add_parser("ssh", help="run a command over SSH")
    ssh.add_argument("host", metavar="HOST", help="host name")
    ssh.add_argument("ssh_command", nargs=argparse.REMAINDER, metavar="COMMAND", help="command to run, default: interactive shell")

    commands.add_parser("hosts", help="list configured Pi hosts")
    return p


def log(msg: str):
    print(f"\033[32m{msg}\033[0m", flush=True)


def warn(msg: str):
    sys.stdout.flush()
    print(f"\033[33mwarn: {msg}\033[0m", file=sys.stderr, flush=True)


def error(msg: str):
    sys.stdout.flush()
    print(f"\033[31merror: {msg}\033[0m", file=sys.stderr, flush=True)


def parse_hosts(path: Path) -> dict[str, dict[str, str]]:
    hosts: dict[str, dict[str, str]] = {}
    current: dict[str, str] = {}
    pending_rootpsw: str | None = None
    if not path.exists():
        return hosts
    for line in path.read_text().splitlines():
        line = line.strip()
        # "# rootpsw: ..." above a host carries its sudo password without
        # making rmt treat the host as password-auth (that's the "password" key)
        m = re.match(r'^#\s*rootpsw:\s*(.+)$', line)
        if m:
            pending_rootpsw = m.group(1).strip()
            continue
        if line == "[[hosts]]":
            current = {}
            if pending_rootpsw is not None:
                current["rootpsw"] = pending_rootpsw
                pending_rootpsw = None
            continue
        m = re.match(r'^(\w+)\s*=\s*"(.*)"$', line)
        if m and current is not None:
            current[m.group(1)] = m.group(2)
            if m.group(1) == "name":
                hosts[m.group(2)] = current
    return hosts


def sudo_password(host: dict[str, str]) -> str:
    return host.get("rootpsw") or host.get("password", "")


def prepare_services(name: str) -> bool:
    """run the host's local build step, if it has one, before staging"""
    script = PI_DIR / "services" / name / "prepare"
    if not script.is_file():
        return True

    res = subprocess.run(["sh", str(script)], capture_output=True)
    out = res.stdout.decode().strip()
    if out:
        print("\n".join(f"  {ln}" for ln in out.splitlines()))
    if res.returncode != 0:
        error(f"{name}: prepare failed: {res.stderr.decode().strip()}")
        return False
    return True


def stage(name: str, staging: Path, services: bool = False):
    """lay out the payload exactly as it should land in the pi's home dir"""
    zsh_src = PI_DIR / "config" / "zsh"
    zsh_dst = staging / ".config" / "zsh"
    zsh_dst.mkdir(parents=True, exist_ok=True)

    shutil.copy2(zsh_src / "zshrc", staging / ".zshrc")
    for f in sorted(zsh_src.glob("*.zsh")):
        shutil.copy2(f, zsh_dst / f.name)

    host_zsh = PI_DIR / "hosts" / f"{name}.zsh"
    shutil.copy2(host_zsh, zsh_dst / "host.zsh")

    # starship has no include directive, so the host palette is concatenated in
    prompt = (PI_DIR / "config" / "starship" / "prompt.toml").read_text()
    palette = (PI_DIR / "hosts" / f"{name}.toml").read_text()
    (staging / ".config" / "starship.toml").write_text(f"{prompt}\n{palette}")

    bin_dst = staging / ".local" / "bin"
    bin_dst.mkdir(parents=True, exist_ok=True)
    for f in sorted((PI_DIR / "bin").iterdir()):
        if f.is_file():
            shutil.copy2(f, bin_dst / f.name)
            (bin_dst / f.name).chmod(0o755)

    scripts_dst = staging / "scripts"
    scripts_dst.mkdir(parents=True, exist_ok=True)
    for f in sorted((PI_DIR / "scripts").iterdir()):
        if f.is_file():
            shutil.copy2(f, scripts_dst / f.name)

    # service configs are root-owned system files, so they land in $HOME inert
    # and only get installed when --services explicitly runs the install script
    services_src = PI_DIR / "services" / name
    if services_src.is_dir():
        services_dst = staging / ".local" / "share" / "pi-services" / name
        services_dst.mkdir(parents=True, exist_ok=True)
        for f in sorted(services_src.iterdir()):
            if f.is_file():
                shutil.copy2(f, services_dst / f.name)
                if f.name == "install":
                    (services_dst / f.name).chmod(0o755)

        # build/ holds artifacts prepare just compiled, too big to push on an
        # ordinary config sync and useless without the install script anyway
        build_src = services_src / "build"
        if services and build_src.is_dir():
            for f in sorted(build_src.iterdir()):
                if f.is_file():
                    shutil.copy2(f, services_dst / f.name)
                    (services_dst / f.name).chmod(0o755)


def run_ssh(host: dict[str, str], name: str, remote_cmd: str | None, stdin: bytes | None = None) -> subprocess.CompletedProcess:
    target = f"{host['user']}@{host.get('host', name)}"
    env = dict(os.environ)
    cmd = ["ssh", *SSH_OPTS, target]
    if remote_cmd is not None:
        cmd.append(remote_cmd)
    if "password" in host:
        env["SSHPASS"] = host["password"]
        cmd = ["sshpass", "-e", *cmd]
    return subprocess.run(cmd, input=stdin, env=env, capture_output=True)


def pull_host(name: str, host: dict[str, str], dry_run: bool) -> bool:
    log(f"\n── {name} (pull) ──")
    files = PULLABLE.get(name, {})
    if not files:
        warn(f"{name}: nothing registered in PULLABLE to pull")
        return True

    ok = True
    for remote_path, local_name in files.items():
        dest = PI_DIR / "services" / name / local_name
        print(f"  {remote_path} -> pi/services/{name}/{local_name}")
        if dry_run:
            continue

        password = sudo_password(host)
        remote_cmd = (
            'IFS= read -r SUDO_PASS; '
            f'printf "%s\\n" "$SUDO_PASS" | sudo -S -p "" cat {shlex.quote(remote_path)}'
        )
        res = run_ssh(host, name, remote_cmd, stdin=password.encode() + b"\n")
        if res.returncode != 0 or not res.stdout:
            error(f"{name}: pull failed for {remote_path}: {res.stderr.decode().strip()}")
            ok = False
            continue

        dest.parent.mkdir(parents=True, exist_ok=True)
        dest.write_bytes(res.stdout)
        log(f"  pulled {local_name}")

    return ok


def sync_host(name: str, host: dict[str, str], bootstrap: bool, services: bool, dry_run: bool) -> bool:
    log(f"\n── {name} ──")
    has_services = (PI_DIR / "services" / name / "install").is_file()

    if services and has_services and not dry_run:
        if not prepare_services(name):
            return False

    with tempfile.TemporaryDirectory() as tmp:
        staging = Path(tmp) / "payload"
        staging.mkdir()
        stage(name, staging, services)

        files = sorted(
            str(p.relative_to(staging)) for p in staging.rglob("*") if p.is_file()
        )
        for f in files:
            print(f"  ~/{f}")

        if dry_run:
            if bootstrap:
                print("  + bootstrap (apk install, login shell)")
            if services and has_services:
                print("  + services install")
            return True

        probe = run_ssh(host, name, "true")
        if probe.returncode != 0:
            warn(f"{name} unreachable, skipping")
            return False

        archive = Path(tmp) / "payload.tar"
        with tarfile.open(archive, "w") as tar:
            for p in sorted(staging.rglob("*")):
                tar.add(p, arcname=str(p.relative_to(staging)))

        # scripts/ is replaced wholesale so files removed locally don't linger remotely
        unpack_cmd = 'rm -rf "$HOME/scripts" && tar -C "$HOME" -xf -'
        res = run_ssh(host, name, unpack_cmd, stdin=archive.read_bytes())
        if res.returncode != 0:
            error(f"{name}: unpack failed: {res.stderr.decode().strip()}")
            return False
        log("  config pushed")

    if bootstrap:
        script = (PI_DIR / "bootstrap").read_bytes()
        password = sudo_password(host)
        # first stdin line is the sudo password so it never reaches the remote process list
        payload = password.encode() + b"\n" + script
        res = run_ssh(host, name, 'IFS= read -r SUDO_PASS; export SUDO_PASS; exec sh -s', stdin=payload)
        out = res.stdout.decode().strip()
        if out:
            print("\n".join(f"  {ln}" for ln in out.splitlines()))
        if res.returncode != 0:
            error(f"{name}: bootstrap failed: {res.stderr.decode().strip()}")
            return False
        log("  bootstrap ok")

    if services and has_services:
        password = sudo_password(host)
        remote_cmd = (
            'IFS= read -r SUDO_PASS; export SUDO_PASS; '
            'exec sh ~/.local/share/pi-services/%s/install' % name
        )
        res = run_ssh(host, name, remote_cmd, stdin=password.encode() + b"\n")
        out = res.stdout.decode().strip()
        if out:
            print("\n".join(f"  {ln}" for ln in out.splitlines()))
        if res.returncode != 0:
            error(f"{name}: services install failed: {res.stderr.decode().strip()}")
            return False
        log("  services install ok")

    return True


def selected_hosts(args, names: list[str]) -> list[str]:
    selected = [*getattr(args, "hosts", []), *(getattr(args, "host_flags", None) or [])]
    if not selected:
        return names
    unknown = sorted(set(selected) - set(names))
    if unknown:
        sys.exit(f"unknown host: {', '.join(unknown)} (have: {', '.join(names)})")
    return list(dict.fromkeys(selected))


def config_hosts() -> tuple[list[str], dict[str, dict[str, str]]]:
    if not PI_DIR.is_dir():
        sys.exit(f"pi/ directory not found at {PI_DIR}")
    names = sorted(p.stem for p in (PI_DIR / "hosts").glob("*.toml"))
    return names, parse_hosts(HOSTS_FILE)


def command_for_hosts(args, action) -> int:
    names, hosts = config_hosts()
    names = selected_hosts(args, names)
    passed, failed = [], []
    for name in names:
        host = hosts.get(name)
        if host is None:
            error(f"no remote-hosts entry for {name}")
            failed.append(name)
            continue
        try:
            if action(name, host):
                passed.append(name)
            else:
                failed.append(name)
        except Exception as exc:
            error(f"{name}: {exc}")
            failed.append(name)
    if passed:
        log(f"ok: {', '.join(passed)}")
    if failed:
        error(f"failed: {', '.join(failed)}")
    return 1 if failed else 0


def ping_host(name: str, host: dict[str, str]) -> bool:
    address = host.get("host", name)
    res = subprocess.run(
        ["ping", "-c", "1", "-W", str(CONNECT_TIMEOUT), address],
        capture_output=True,
        text=True,
    )
    if res.returncode == 0:
        log(f"{name}: reachable")
        return True
    lines = res.stdout.strip().splitlines()
    detail = res.stderr.strip() or (lines[-1] if lines else "")
    warn(f"{name}: unreachable{': ' + detail if detail else ''}")
    return False


def ip_host(name: str, host: dict[str, str]) -> bool:
    res = run_ssh(host, name, "hostname -I")
    if res.returncode != 0:
        warn(f"{name}: unreachable{': ' + res.stderr.decode().strip() if res.stderr else ''}")
        return False
    print(f"{name}: {' '.join(res.stdout.decode().split()) or '(no addresses)'}")
    return True


def reboot_host(name: str, host: dict[str, str]) -> bool:
    password = sudo_password(host)
    res = run_ssh(host, name, 'IFS= read -r SUDO_PASS; printf "%s\\n" "$SUDO_PASS" | sudo -S -p "" reboot', stdin=password.encode() + b"\n")
    if res.returncode != 0:
        error(f"{name}: reboot failed: {res.stderr.decode().strip()}")
        return False
    log(f"{name}: rebooting")
    return True


def run_sync(args, pull: bool = False) -> int:
    names, hosts = config_hosts()
    names = selected_hosts(args, names)
    if shutil.which("sshpass") is None:
        warn("sshpass not found, only key-auth hosts will work")
    if args.dry_run:
        print("[dry run]")

    synced, skipped, failed = [], [], []
    for name in names:
        host = hosts.get(name)
        if host is None:
            error(f"no remote-hosts entry for {name}, skipping")
            failed.append(name)
            continue
        try:
            ok = pull_host(name, host, args.dry_run) if pull else sync_host(name, host, args.bootstrap, args.services, args.dry_run)
        except Exception as exc:  # one bad host must never take the others down
            error(f"{name}: {exc}")
            failed.append(name)
            continue
        (synced if ok else skipped).append(name)

    print()
    if synced:
        log(f"synced: {', '.join(synced)}")
    if skipped:
        warn(f"skipped: {', '.join(skipped)}")
    if failed:
        error(f"failed: {', '.join(failed)}")

    # offline boxes are expected, a real error is not
    return 1 if failed or not synced else 0


def main() -> int:
    p = parser()
    args = p.parse_args()
    if args.command is None:
        p.print_help()
        return 0
    if args.command == "hosts":
        names, hosts = config_hosts()
        for name in names:
            host = hosts.get(name, {})
            print(f"{name}\t{host.get('user', '?')}@{host.get('host', name)}")
        return 0
    if args.command == "sync":
        return run_sync(args)
    if args.command in {"fetch", "pull"}:
        return run_sync(args, pull=True)
    if args.command == "ping":
        return command_for_hosts(args, ping_host)
    if args.command == "ip":
        return command_for_hosts(args, ip_host)
    if args.command == "reboot":
        if not args.hosts and not args.host_flags and not args.all:
            p.error("pi reboot needs at least one HOST, or --all")
        return command_for_hosts(args, reboot_host)
    if args.command == "ssh":
        names, hosts = config_hosts()
        if args.host not in names:
            p.error(f"unknown host: {args.host} (have: {', '.join(names)})")
        command = " ".join(args.ssh_command) if args.ssh_command else None
        res = run_ssh(hosts[args.host], args.host, command)
        return res.returncode
    p.error(f"unknown command: {args.command}")


if __name__ == "__main__":
    sys.exit(main())
