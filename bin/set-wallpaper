#!/usr/bin/env bash
#@ set wallpaper on all monitors and persist it for wallpaper-restore

set -e

path="$1"
if [ -z "$path" ]; then
	notify-send -t 3000 "✦ wallpaper" "no wallpaper given"
	exit 1
fi

awww img "$path" \
	--transition-type simple \
	--transition-step 2 \
	--transition-fps 60

state="${XDG_STATE_HOME:-$HOME/.local/state}/wallpaper"
mkdir -p "$(dirname "$state")"
echo "$path" >"$state"

notify-send -t 2000 "✦ wallpaper" "$(basename "$path")"
