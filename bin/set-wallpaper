#!/usr/bin/env bash
#@ set wallpaper on all monitors and persist it for wallpaper-restore

set -e

bin_dir="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"

path="$1"
if [ -z "$path" ]; then
	notify-send -t 3000 "✦ wallpaper" "no wallpaper given"
	exit 1
fi

state="${XDG_STATE_HOME:-$HOME/.local/state}/wallpaper"
mkdir -p "$(dirname "$state")"
echo "$path" >"$state"

if [ "$("$bin_dir/wallpaper-kind" "$path")" = live ]; then
	notify-send -t 2000 "✦ wallpaper" "$(basename "$path") (live)"
else
	notify-send -t 2000 "✦ wallpaper" "$(basename "$path")"
fi

exec "$bin_dir/wallpaper-apply" "$path"
