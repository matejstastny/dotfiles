#!/usr/bin/env bash
set -euo pipefail

# bigrepo - speed up git status in the current repo
# enables git's filesystem-monitor daemon + untracked cache so the shell
# prompt stops running a full working-tree scan on every render.

if ! root=$(git rev-parse --show-toplevel 2>/dev/null); then
	echo "err: not inside a git repository"
	exit 1
fi

name=$(basename "$root")
files=$(git -C "$root" ls-files | wc -l | tr -d ' ')

fstype=$(stat -f -c %T "$root" 2>/dev/null || echo unknown)
case "$fstype" in
nfs* | smb* | cifs | fuse*)
	echo "warn: '$root' is on a $fstype mount — fsmonitor may miss events"
	echo "      enabling anyway; run 'git config core.fsmonitor false' here if status looks stale"
	;;
esac

git -C "$root" config core.fsmonitor true
git -C "$root" config core.untrackedCache true
git -C "$root" update-index --index-version 4 >/dev/null 2>&1 || true
git -C "$root" status --porcelain >/dev/null 2>&1 || true
git -C "$root" status --porcelain >/dev/null 2>&1 || true

echo "✦ git optimization enabled for $name"
