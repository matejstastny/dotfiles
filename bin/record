#!/usr/bin/env bash

PID_FILE="/tmp/gpu-screen-recorder.pid"
OUT_DIR="$HOME/pictures/screenrecord"

if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
	kill -SIGINT "$(cat "$PID_FILE")"
	rm -f "$PID_FILE"
	notify-send -t 3000 "✦ recording" "Saved to $OUT_DIR"
else
	mkdir -p "$OUT_DIR"
	FILE="$OUT_DIR/$(date +%Y-%m-%d_%H-%M-%S).mkv"
	MONITOR=$(hyprctl monitors -j | jq -r '.[] | select(.focused) | .name')
	wf-recorder -o "$MONITOR" -a -f "$FILE" &
	echo $! >"$PID_FILE"
	notify-send -t 2000 "✦ recording" "Started · $FILE"
fi
