#!/usr/bin/env bash
#@ flash an iso/img to a usb drive with dd

set -euo pipefail

[[ $# -eq 1 ]] || {
	echo "usage: flash <path-to-iso/img>" >&2
	exit 1
}

iso="$1"
[[ -f "$iso" ]] || {
	echo "iso not found: $iso" >&2
	exit 1
}

mapfile -t drives < <(lsblk -dpno NAME,SIZE,VENDOR,MODEL,TRAN | awk '$NF=="usb"')
[[ ${#drives[@]} -gt 0 ]] || {
	echo "no usb drives found" >&2
	exit 1
}

echo "available usb drives:"
for i in "${!drives[@]}"; do
	echo "  [$((i + 1))] ${drives[$i]}"
done

read -rp "select a drive [1-${#drives[@]}]: " choice
[[ "$choice" =~ ^[0-9]+$ ]] && ((choice >= 1 && choice <= ${#drives[@]})) || {
	echo "invalid selection" >&2
	exit 1
}

device=$(awk '{print $1}' <<<"${drives[$((choice - 1))]}")

for part in $(lsblk -lnpo NAME "$device" | tail -n +2); do
	mnt=$(lsblk -no MOUNTPOINT "$part")
	[[ -n "$mnt" ]] && sudo umount "$part"
done

echo "write $iso to $device? this erases everything on it."
read -rp "continue? [y/N] " confirm
[[ "$confirm" == [yY] ]] || exit 1

pv -s "$(stat -c%s "$iso")" "$iso" | sudo dd of="$device" bs=4M conv=fsync
sync

notify-send -t 3000 "✦ flash" "wrote $(basename "$iso") to $device"
echo "done"
