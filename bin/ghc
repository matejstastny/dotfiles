#!/bin/bash

# neat script for cloning cause git clone is long to write and gh repo clone sucks

set -euo pipefail

if [ $# -eq 0 ]; then
	echo "no repo passed"
	exit 1
fi

REPO=$1
declare -a accounts=(
	"matejstastny"
	"TrickFireRobotics"
)

check_repo_exists() {
	repoUrl="$1"
	myStr="$(git ls-remote -q "$repoUrl" &>/dev/null)"
	return_code=$?
	if [ $return_code -eq 0 ]; then
		echo "yesh"
	else
		echo "no :("
	fi
}

for account in "${accounts[@]}"; do
	URL="git@github.com:${account}/$REPO"
	if [[ $(check_repo_exists "$URL") == "yesh" ]]; then
		git clone "$URL"
		exit 0
	fi
done
echo "repo not found in any of the accounts"
exit 1
