#!/usr/bin/env bash
set -euo pipefail

dir="$1"

if [[ ! -d "$dir" ]]; then
	echo "err: '$dir' is not a directory"
	exit 1
fi

count=0
while IFS= read -r -d '' link; do
	echo "removing $link"
	rm "$link"
	((count++)) || true
done < <(find "$dir" -maxdepth 1 -type l ! -exec test -e {} \; -print0)

echo "removed $count dead symlinks"
