#!/usr/bin/env bash
#@ restore wallpaper

state="${XDG_STATE_HOME:-$HOME/.local/state}/wallpaper"
wallpaper=$(<"$state")

until awww query &>/dev/null; do sleep 0.1; done

output="$1"
outputs_flag=()
[ -n "$output" ] && outputs_flag=(-o "$output")

exec awww img "$wallpaper" \
	"${outputs_flag[@]}" \
	--transition-type simple \
	--transition-step 2 \
	--transition-fps 60
