#!/bin/bash
#@ clone/setup fairydust installer

set -eu

FAIRYDUST_DIR="$HOME/dotfiles/fairydust"
KERNEL_SRC_DIR="$HOME/linux-fairydust"

if [ -d "$FAIRYDUST_DIR" ]; then
	echo "==> Repo exists. Pulling..."
	cd "$FAIRYDUST_DIR" && git pull
else
	echo "==> Cloning installer..."
	git clone https://github.com/bharambetejas/asahi-fairydust-display.git "$FAIRYDUST_DIR"
fi

echo "==> Adding exec perms..."
chmod +x "$FAIRYDUST_DIR"/*.sh

if [ -d "$KERNEL_SRC_DIR" ]; then
	echo "==> Removing stale kernel source at $KERNEL_SRC_DIR..."
	rm -rf "$KERNEL_SRC_DIR"
fi

CURRENT_KVER="$(uname -r)"
if [ ! -f "/boot/config-$CURRENT_KVER" ]; then
	# arm64's install.sh never writes /boot/config-<version> (unlike x86), so
	# once booted into a fairydust kernel there's no config for the build
	# script to copy as its base. Seed it from the stock 16k kernel's config.
	STOCK_CONFIG="$(ls -t /boot/config-*+16k 2>/dev/null | head -1)"
	if [ -z "$STOCK_CONFIG" ]; then
		echo "==> ERROR: no stock kernel config found to seed /boot/config-$CURRENT_KVER" >&2
		exit 1
	fi
	echo "==> Seeding /boot/config-$CURRENT_KVER from $STOCK_CONFIG..."
	sudo cp "$STOCK_CONFIG" "/boot/config-$CURRENT_KVER"
fi

echo "==> Running build script..."
"$FAIRYDUST_DIR/asahi-fairydust-build.sh"
