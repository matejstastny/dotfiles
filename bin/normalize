#!/usr/bin/env bash
#@ rename photos/videos to YYYYMMDD_HHMMSS and backfill missing/mismatched datetime tags

set -euo pipefail

WRITE=0
DIR="."

for arg in "$@"; do
	case "$arg" in
		--write) WRITE=1 ;;
		*) DIR="$arg" ;;
	esac
done

DIR="$(realpath "$DIR" 2>/dev/null)"
if [[ -z "$DIR" || ! -d "$DIR" ]]; then
	echo "not a directory: ${1:-.}" >&2
	exit 1
fi

command -v exiftool >/dev/null || { echo "exiftool not found, install perl-Image-ExifTool" >&2; exit 1; }

mapfile -d '' FILES < <(find "$DIR" -type d -name '.*' -prune -o -type f \( \
	-iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.heic' -o -iname '*.mp4' -o -iname '*.mov' \
	\) -print0 | sort -z)

if [[ ${#FILES[@]} -eq 0 ]]; then
	echo "no photos/videos found in $DIR"
	exit 0
fi

JSON="$(exiftool -json -EXIF:DateTimeOriginal -EXIF:CreateDate \
	-QuickTime:CreateDate -QuickTime:MediaCreateDate -QuickTime:TrackCreateDate \
	-File:FileModifyDate "${FILES[@]}")"

declare -A USED_NAMES
RENAMED=0
TAGGED=0
UNCHANGED=0
SKIPPED=0

while IFS= read -r -d '' existing; do
	USED_NAMES["$existing"]=1
done < <(find "$DIR" -type d -name '.*' -prune -o -type f -print0)

extract_dt() {
	# sets DT_Y DT_M DT_D DT_h DT_m DT_s from a "YYYY:MM:DD HH:MM:SS..." string
	local raw="$1"
	if [[ "$raw" =~ ([0-9]{4}):([0-9]{2}):([0-9]{2})[[:space:]]([0-9]{2}):([0-9]{2}):([0-9]{2}) ]]; then
		DT_Y="${BASH_REMATCH[1]}"; DT_M="${BASH_REMATCH[2]}"; DT_D="${BASH_REMATCH[3]}"
		DT_h="${BASH_REMATCH[4]}"; DT_m="${BASH_REMATCH[5]}"; DT_s="${BASH_REMATCH[6]}"
		[[ "$DT_Y" != "0000" ]]
		return $?
	fi
	return 1
}

while IFS= read -r row; do
	src="$(jq -r '.SourceFile' <<<"$row")"
	base="$(basename "$src")"
	dir_of_src="$(dirname "$src")"
	ext="${base##*.}"
	ext_lower="$(tr '[:upper:]' '[:lower:]' <<<"$ext")"

	dto="$(jq -r '.DateTimeOriginal // empty' <<<"$row")"
	cd_="$(jq -r '.CreateDate // empty' <<<"$row")"
	mcd="$(jq -r '.MediaCreateDate // empty' <<<"$row")"
	tcd="$(jq -r '.TrackCreateDate // empty' <<<"$row")"
	fmd="$(jq -r '.FileModifyDate // empty' <<<"$row")"

	tier=0
	if [[ -n "$dto" ]] && extract_dt "$dto"; then
		tier=1
	elif [[ -n "$cd_" ]] && extract_dt "$cd_"; then
		tier=2
	elif [[ -n "$mcd" ]] && extract_dt "$mcd"; then
		tier=2
	elif [[ -n "$tcd" ]] && extract_dt "$tcd"; then
		tier=2
	elif [[ "${base%.*}" =~ ^([0-9]{4})([0-9]{2})([0-9]{2})_([0-9]{2})([0-9]{2})([0-9]{2}) ]]; then
		DT_Y="${BASH_REMATCH[1]}"; DT_M="${BASH_REMATCH[2]}"; DT_D="${BASH_REMATCH[3]}"
		DT_h="${BASH_REMATCH[4]}"; DT_m="${BASH_REMATCH[5]}"; DT_s="${BASH_REMATCH[6]}"
		tier=3
	elif [[ -n "$fmd" ]] && extract_dt "$fmd"; then
		tier=4
	else
		echo "skip (no usable date source): $base" >&2
		SKIPPED=$((SKIPPED + 1))
		continue
	fi

	target_base="${DT_Y}${DT_M}${DT_D}_${DT_h}${DT_m}${DT_s}"
	target="${target_base}.${ext_lower}"
	target_path="$dir_of_src/$target"
	suffix=2
	while [[ -n "${USED_NAMES[$target_path]:-}" && "$target" != "$base" ]]; do
		target="${target_base}_${suffix}.${ext_lower}"
		target_path="$dir_of_src/$target"
		suffix=$((suffix + 1))
	done
	USED_NAMES["$target_path"]=1

	exif_dt="${DT_Y}:${DT_M}:${DT_D} ${DT_h}:${DT_m}:${DT_s}"
	rename_needed=0
	[[ "$target" != "$base" ]] && rename_needed=1
	tag_needed=0
	[[ "$tier" != "1" ]] && tag_needed=1

	if [[ "$rename_needed" -eq 0 && "$tag_needed" -eq 0 ]]; then
		UNCHANGED=$((UNCHANGED + 1))
		continue
	fi

	action=""
	[[ "$rename_needed" -eq 1 ]] && action+="rename -> $target  "
	[[ "$tag_needed" -eq 1 ]] && action+="tag[source tier $tier]"
	echo "$base: $action"

	current="$src"
	if [[ "$WRITE" -eq 1 ]]; then
		if [[ "$rename_needed" -eq 1 ]]; then
			mv -n "$current" "$dir_of_src/$target"
			current="$dir_of_src/$target"
		fi
		if [[ "$tag_needed" -eq 1 ]]; then
			case "$ext_lower" in
				jpg|jpeg|heic)
					exiftool -q -m -overwrite_original "-AllDates=$exif_dt" "$current" ;;
				mp4|mov)
					exiftool -q -m -overwrite_original \
						"-QuickTime:CreateDate=$exif_dt" "-QuickTime:ModifyDate=$exif_dt" \
						"-QuickTime:MediaCreateDate=$exif_dt" "-QuickTime:MediaModifyDate=$exif_dt" \
						"-QuickTime:TrackCreateDate=$exif_dt" "-QuickTime:TrackModifyDate=$exif_dt" \
						"$current" ;;
			esac
		fi
	fi

	[[ "$rename_needed" -eq 1 ]] && RENAMED=$((RENAMED + 1))
	[[ "$tag_needed" -eq 1 ]] && TAGGED=$((TAGGED + 1))
done < <(jq -c '.[]' <<<"$JSON")

echo
if [[ "$WRITE" -eq 1 ]]; then
	echo "renamed $RENAMED, tagged $TAGGED, unchanged $UNCHANGED, skipped $SKIPPED"
	notify-send -t 4000 "✦ normalize" "renamed $RENAMED, tagged $TAGGED file(s) in $DIR"
else
	echo "dry-run: would rename $RENAMED, tag $TAGGED, unchanged $UNCHANGED, skipped $SKIPPED (pass --write to apply)"
fi
