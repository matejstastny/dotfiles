    <div class="swatch-name">$PURPLE_NAME</div>
    <div class="swatch-hex">$PURPLE</div>
  </div>
  <div class="swatch">
    <div class="block" style="background:$ROSE"></div>
    <div class="swatch-name">$ROSE_NAME</div>
    <div class="swatch-hex">$ROSE</div>
  </div>
  <div class="swatch">
