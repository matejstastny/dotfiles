}
.swatch-name {
  color: $DIM;
  font-size: 10px;
  text-align: center;
  letter-spacing: 0.5px;
}
.swatch-hex {
  color: $MUTED;
  font-size: 9px;
  text-align: center;
  letter-spacing: 0.3px;
}

.ansi-section {
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.ansi-label {
  color: $MUTED;
  font-size: 9px;
  letter-spacing: 1.5px;
  text-transform: uppercase;
}
.ansi-row {
  display: flex;
  gap: 6px;
}
