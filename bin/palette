    <div class="swatch-name">$TEXT_NAME</div>
    <div class="swatch-hex">$TEXT</div>
  </div>
  <div class="swatch">
    <div class="block" style="background:$DIM"></div>
    <div class="swatch-name">$DIM_NAME</div>
