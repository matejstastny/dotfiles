/usr/bin/helium \
	--headless=new \
	--no-sandbox \
	--disable-gpu \
	--force-device-scale-factor=2 \
	--window-size=860,300 \
	--screenshot="$OUT" \
	"file://$TMPHTML" 2>/dev/null

notify-send -t 3000 "✦ palette" "saved to $OUT"
echo "$OUT"
