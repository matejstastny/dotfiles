#!/usr/bin/env bash
#@ pallete generator for repo readme

# palette
BASE="#11111b" BASE_NAME="base"
SURFACE="#181825" SURFACE_NAME="surface"
OVERLAY="#25253a" OVERLAY_NAME="overlay"
MUTED="#3d3d5c" MUTED_NAME="muted"
PURPLE="#7878c8" PURPLE_NAME="purple"
ROSE="#c47ab8" ROSE_NAME="rose"
TEXT="#dce0f4" TEXT_NAME="text"
DIM="#9898c0" DIM_NAME="dim"
BRIGHT="#f0f0ff" BRIGHT_NAME="bright"

# terminal
ANSI_0="#181825" ANSI_8="#3d3d5c"
ANSI_1="#c47ab8" ANSI_9="#d48fc8"
ANSI_2="#7a9bbf" ANSI_10="#8fb8d8"
ANSI_3="#c4a87a" ANSI_11="#d4b890"
ANSI_4="#7878c8" ANSI_12="#9898e0"
ANSI_5="#c47ab8" ANSI_13="#d494cc"
ANSI_6="#7abfc4" ANSI_14="#90d0d4"
ANSI_7="#dce0f4" ANSI_15="#f0f0ff"

