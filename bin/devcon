#!/usr/bin/env bash
#@ build and attach to a devcontainer using microslop's cli

set -euo pipefail

rebuild=false
no_cache=false
while [[ $# -gt 0 ]]; do
	case "$1" in
	--rebuild)
		rebuild=true
		shift
		;;
	--no-cache)
		no_cache=true
		shift
		;;
	*)
		echo "devcon: unknown argument: $1" >&2
		exit 1
		;;
	esac
done

find_workspace() {
	local dir="$PWD"
	while [[ "$dir" != "/" ]]; do
		[[ -f "$dir/.devcontainer/devcontainer.json" || -f "$dir/.devcontainer.json" ]] && {
			echo "$dir"
			return 0
		}
		dir="$(dirname "$dir")"
	done
	return 1
}

workspace="$(find_workspace)" || {
	echo "devcon: no devcontainer config found" >&2
	exit 1
}

up_args=(--workspace-folder "$workspace")
$rebuild && up_args+=(--remove-existing-container)
$no_cache && up_args+=(--build-no-cache)

devcontainer up "${up_args[@]}"
preferred="${SHELL##*/}"
shell=$(devcontainer exec --workspace-folder "$workspace" -- sh -c \
	"for s in $preferred bash sh; do command -v \"\$s\" 2>/dev/null && break; done")
[[ -z "$shell" ]] && {
	echo "devcon: no usable shell found in container" >&2
	exit 1
}
exec devcontainer exec --workspace-folder "$workspace" -- "$shell"
