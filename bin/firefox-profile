#!/usr/bin/env bash

# firefox-profile - create a .desktop launcher for a Firefox profile

PROFILE_NAME="trickfire"
APP_NAME="Firefox (Trickfire)"
ICON="firefox"
DESKTOP_FILENAME="firefox-trickfire"
# WM_CLASS=""

# ----

DEST="$HOME/.local/share/applications/${DESKTOP_FILENAME}.desktop"

EXEC="firefox -P \"${PROFILE_NAME}\" --no-remote"
if [ -n "$WM_CLASS" ]; then
    EXEC="env MOZ_APP_REMOTINGNAME=${WM_CLASS} firefox -P \"${PROFILE_NAME}\" --no-remote --class=${WM_CLASS}"
fi

mkdir -p "$(dirname "$DEST")"

cat > "$DEST" <<EOF
[Desktop Entry]
Version=1.0
Name=${APP_NAME}
Exec=${EXEC}
Icon=${ICON}
Terminal=false
Type=Application
Categories=Network;WebBrowser;
StartupWMClass=${WM_CLASS:-firefox}
EOF

chmod +x "$DEST"
echo "Created: $DEST"
