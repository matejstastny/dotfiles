#!/usr/bin/env python3
#@ dotfiles manager/symlinker

import sys
from pathlib import Path

_ROOT = Path(__file__).resolve().parent.parent
CONFIGS_DIR = _ROOT / "configs"
CONF_FILE = _ROOT / "link.conf"
DEFAULT_TARGET = Path.home() / ".config"

dry_run = "--dry-run" in sys.argv

def log(msg: str):
    print(f"\033[32m{msg}\033[0m")

def error(msg: str):
    print(f"\033[31merror: {msg}\033[0m", file=sys.stderr)

def get_pad(item_len: int, name: str, msg: str) -> str:
    return f"{name.ljust(item_len)}: {msg}"


def symlink(src: Path, dst: Path):
    dst = dst.expanduser()
    src = src.resolve()
    if dst.is_symlink():
        if dst.readlink().resolve() == src:
            return
        error(f"skip (exists, different target): {dst}")
        return
    if dst.exists():
        error(f"skip (not a symlink): {dst}")
        return
    log(f"  {src} -> {dst}")
    if not dry_run:
        dst.parent.mkdir(parents=True, exist_ok=True)
        dst.symlink_to(src)


def parse_conf(path: Path) -> dict[str, dict[str, list[str]]]:
    sections: dict[str, dict[str, list[str]]] = {}
    current = None
    if not path.exists():
        return sections
    with open(path) as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith('#') or line.startswith(';'):
                continue
            if line.startswith('[') and line.endswith(']'):
                current = line[1:-1]
                sections[current] = {}
            elif '=' in line and current is not None:
                key, _, val = line.partition('=')
                sections[current].setdefault(key.strip(), []).append(val.strip())
    return sections


def main():
    if not CONFIGS_DIR.is_dir():
        sys.exit(f"configs/ directory not found at {CONFIGS_DIR}")

    conf = parse_conf(CONF_FILE)
    path_overrides = conf.get("path_overrides", {})
    file_overrides = conf.get("file_overrides", {})
    file_links = conf.get("file_links", {})

    item_len = 0
    for src in CONFIGS_DIR.iterdir():
        if not src.is_dir():
            continue
        item_len = max(item_len, len(src.name))
    for src_rel in file_links:
        item_len = max(item_len, len(src_rel))
    item_len += 2

    if dry_run:
        print("[dry run]")

    for src in sorted(CONFIGS_DIR.iterdir()):
        if not src.is_dir():
            continue
        name = src.name

        if name in file_overrides:
            targets = [Path(t) for t in file_overrides[name]]
            label = ", ".join(str(t) for t in targets)
            log(get_pad(item_len, name, f" files link    -> {label}"))
            for target_dir in targets:
                for f in sorted(src.iterdir()):
                    symlink(f, target_dir / f.name)
        elif name in path_overrides:
            targets = [Path(t) for t in path_overrides[name]]
            label = ", ".join(str(t) for t in targets)
            log(get_pad(item_len, name, f" path override -> {label}"))
            for target in targets:
                symlink(src, target)
        else:
            log(get_pad(item_len, name, f" default       -> {DEFAULT_TARGET / name}"))
            symlink(src, DEFAULT_TARGET / name)

    for src_rel, targets in sorted(file_links.items()):
        src = _ROOT / src_rel
        target_paths = [Path(t) for t in targets]
        label = ", ".join(str(t) for t in target_paths)
        log(get_pad(item_len, src_rel, f" file link     -> {label}"))
        for target in target_paths:
            symlink(src, target)


if __name__ == "__main__":
    main()
