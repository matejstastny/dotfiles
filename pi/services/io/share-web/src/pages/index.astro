---
import Base from "../layouts/Base.astro";
---

<Base title="share · io">
    <section class="row">
        <span class="label">send</span>
        <div>
            <label class="dropzone" id="drop">
                <input type="file" id="file" hidden />
                <span id="drop-text">drop a file here or click to choose</span>
            </label>
            <p class="hint">one at a time · up to 10 kept, oldest rolls off past the cap</p>
        </div>
    </section>

    <section class="row" id="status" hidden>
        <span class="label">status</span>
        <div>
            <p class="stage" id="stage"></p>
            <div class="bar"><div class="bar-fill" id="fill"></div></div>
            <p class="nums" id="nums"></p>
            <p class="note" id="note"></p>
        </div>
    </section>

    <section class="row">
        <span class="label">kept</span>
        <div>
            <div class="meter"><div class="meter-fill" id="meter-fill"></div></div>
            <p class="nums" id="usage">reading…</p>
        </div>
    </section>

    <section class="row">
        <span class="label">files</span>
        <div>
            <ul class="files" id="files"></ul>
            <p class="empty" id="empty" hidden></p>
        </div>
    </section>
</Base>

<script>
    import "../scripts/app";
</script>
