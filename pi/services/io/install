#!/bin/sh

set -eu

as_root() {
	printf '%s\n' "${SUDO_PASS:-}" | sudo -S -p '' "$@"
}

self="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

if [ ! -f "$self/ytdl" ]; then
	echo "  ! no ytdl binary in this payload"
	echo "    it is built on your laptop, so run: bin/pi-sync --host io --services"
	exit 1
fi

echo "▸ enabling community repo"
as_root sh -c 'grep -q "^[^#]*/community" /etc/apk/repositories || sed -i "s|^#\(.*/community\)\$|\1|" /etc/apk/repositories'
# the mirror resolves to an ipv6 address io cannot reach often enough that a
# wobble here must not abandon the whole install; apk add still has the index
as_root apk update >/dev/null 2>&1 || echo "  ! apk update failed, carrying on with the cached index"

echo "▸ ytdl: installing yt-dlp and ffmpeg"
as_root apk add yt-dlp ffmpeg

echo "▸ anisette-v3: installing container runtime"
as_root apk add docker docker-openrc git
as_root rc-update add docker default
as_root rc-service docker start || as_root rc-service docker restart

# build the current upstream source rather than trust its older prebuilt image
# the commit is deliberately pinned: upgrades are reviewed by changing this value
anisette_rev=684895737aaf1a1c4586fcd5b67509ffd500a36c
anisette_image="local/anisette-v3:${anisette_rev}"
if ! as_root docker image inspect "$anisette_image" >/dev/null 2>&1; then
	echo "▸ anisette-v3: building pinned upstream source"
	as_root docker build --pull -t "$anisette_image" "https://github.com/Dadoum/anisette-v3-server.git#${anisette_rev}"
fi

echo "▸ anisette-v3: creating persistent state and service"
as_root install -d -o 1000 -g 1000 -m 700 /var/lib/anisette-v3
as_root docker rm -f anisette-v3 >/dev/null 2>&1 || true
as_root docker create --name anisette-v3 --restart no \
	-p 127.0.0.1:6969:6969 \
	-v /var/lib/anisette-v3:/home/Alcoholic/.config/anisette-v3 \
	"$anisette_image" >/dev/null
as_root install -o root -g root -m 755 "$self/anisette-v3.initd" /etc/init.d/anisette-v3
as_root rc-update add anisette-v3 default

echo "▸ ytdl: creating system user"
as_root sh -c 'getent group ytdl >/dev/null || addgroup -S ytdl'
as_root sh -c 'getent passwd ytdl >/dev/null || adduser -S -D -H -h /var/lib/ytdl -s /sbin/nologin -G ytdl ytdl'

# jellyfin and navidrome will want to read the same library later, so it is
# group owned from the start rather than being chowned in a panic afterwards
as_root sh -c 'getent group media >/dev/null || addgroup -S media'
as_root addgroup ytdl media 2>/dev/null || true

echo "▸ ytdl: creating directories"
as_root install -d -o ytdl -g ytdl -m 755 /var/lib/ytdl /var/lib/ytdl/cache /var/log/ytdl
as_root install -d -o ytdl -g media -m 2775 /srv/media /srv/media/video /srv/media/music

echo "▸ ytdl: installing the service"
# a running binary cannot be overwritten, so stop first on an upgrade
as_root rc-service ytdl stop >/dev/null 2>&1 || true
as_root install -o root -g root -m 755 "$self/ytdl" /usr/local/bin/ytdl
as_root install -o root -g root -m 755 "$self/ytdl.initd" /etc/init.d/ytdl
as_root install -o root -g root -m 644 "$self/ytdl.confd" /etc/conf.d/ytdl

echo "▸ jellyfin: installing"
as_root apk add jellyfin jellyfin-web jellyfin-openrc
as_root install -o root -g root -m 644 "$self/jellyfin.confd" /etc/conf.d/jellyfin

echo "▸ transmission: installing"
as_root apk add transmission-daemon transmission-daemon-openrc

# it only writes into the library through the done script below, but that
# still needs group write access to /srv/media/video
as_root addgroup transmission media 2>/dev/null || true

as_root install -d -o transmission -g transmission -m 700 /var/lib/transmission/config
as_root install -d -o transmission -g transmission -m 755 /var/lib/transmission/incomplete

# finished downloads land in elara's home instead of transmission's own, so
# she can browse/scp them directly; setgid + group media so transmission (a
# member of media, added above) can still write into it
as_root install -d -o elara -g media -m 2775 /home/elara/jellyfin

# a .torrent file dropped here gets picked up and started automatically, and
# deleted once queued (trash-original-torrent-files in the settings below)
as_root install -d -o elara -g media -m 2775 /home/elara/torrents
# settings.json is only seeded on first run; transmission owns it after that,
# so re-running install never clobbers whatever you've since changed in the ui
if as_root test ! -f /var/lib/transmission/config/settings.json; then
	as_root install -o transmission -g transmission -m 600 "$self/transmission-settings.json" /var/lib/transmission/config/settings.json
fi

as_root install -d -o root -g root -m 755 /usr/local/libexec
as_root install -o root -g root -m 755 "$self/transmission-done" /usr/local/libexec/transmission-done

echo "▸ caddy: creating system user"
as_root sh -c 'getent group caddy >/dev/null || addgroup -S caddy'
as_root sh -c 'getent passwd caddy >/dev/null || adduser -S -D -H -h /var/lib/caddy -s /sbin/nologin -G caddy caddy'
as_root install -d -o caddy -g caddy -m 700 /var/lib/caddy
as_root install -d -o caddy -g caddy -m 755 /var/log/caddy

if [ ! -x /usr/local/bin/caddy ]; then
	echo "▸ caddy: fetching custom build (cloudflare DNS plugin, linux/arm64)"
	as_root sh -c 'curl -sL -o /usr/local/bin/caddy.new "https://caddyserver.com/api/download?os=linux&arch=arm64&p=github.com/caddy-dns/cloudflare" && chmod 755 /usr/local/bin/caddy.new && mv /usr/local/bin/caddy.new /usr/local/bin/caddy'
else
	echo "▸ caddy: binary already present, leaving it alone"
fi

echo "▸ caddy: installing config"
as_root install -d -o root -g caddy -m 755 /etc/caddy
as_root install -o root -g caddy -m 640 "$self/Caddyfile" /etc/caddy/Caddyfile
as_root install -o root -g root -m 755 "$self/caddy.initd" /etc/init.d/caddy
as_root install -o root -g root -m 644 "$self/caddy.confd" /etc/conf.d/caddy

echo "▸ enabling and starting services"
as_root rc-update add ytdl default
as_root rc-update add jellyfin default
as_root rc-update add transmission-daemon default
as_root rc-update add caddy default
as_root rc-service anisette-v3 start || as_root rc-service anisette-v3 restart
as_root rc-service ytdl start || as_root rc-service ytdl restart
as_root rc-service jellyfin start || as_root rc-service jellyfin restart
as_root rc-service transmission-daemon start || as_root rc-service transmission-daemon restart

if as_root test -f /etc/caddy/caddy.env; then
	# "start" on an already-running service just no-ops successfully, so it
	# never picks up a changed Caddyfile on its own; reload explicitly instead
	if as_root rc-service caddy status >/dev/null 2>&1; then
		as_root rc-service caddy reload
	else
		as_root rc-service caddy start
	fi
else
	echo "  ! /etc/caddy/caddy.env is missing (Cloudflare API token)"
	echo "    caddy will not start until you create it by hand:"
	echo "      ssh io 'sudo sh -c \"umask 077; cat > /etc/caddy/caddy.env\"'"
	echo "      # paste CF_API_TOKEN=<token>, Enter, Ctrl-D"
	echo "    this is deliberately not tracked in git, it's a live secret"
	echo "    then: ssh io 'sudo rc-service caddy start'"
fi

echo "  ! yt.elara.boo, jellyfin.elara.boo and torrent.elara.boo need DNS rewrites"
echo "    in AdGuard Home pointing at io's Tailscale address:"
echo "      $(tailscale ip -4 2>/dev/null | head -1)"
echo "  ! anisette.elara.boo must point at io's LAN address, so SideStore works"
echo "    on home Wi-Fi without also requiring Tailscale on the phone:"
echo "      $(ip -4 -o addr show wlan0 2>/dev/null | awk '{ print $4 }' | cut -d/ -f1)"

echo "  ! jellyfin needs its first-run setup wizard, can't be scripted:"
echo "      http://jellyfin.elara.boo or http://<io's lan ip>:8096"
echo "      add /srv/media/video as a Home Videos library, /srv/media/music as Music"

echo "  ! transmission's rpc has no login of its own, loopback bind + caddy's"
echo "    tailnet/lan gate on torrent.elara.boo is the only thing guarding it"

if as_root test ! -f /var/lib/ytdl/cookies.txt; then
	echo "  ! no /var/lib/ytdl/cookies.txt yet"
	echo "    age-restricted videos will fail with 'Sign in to confirm your age' until"
	echo "    one is there. export cookies.txt from a logged-in browser (a 'Get"
	echo "    cookies.txt' extension) and copy it over:"
	echo "      scp cookies.txt io:/tmp/cookies.txt"
	echo "      ssh io 'sudo install -o ytdl -g ytdl -m 600 /tmp/cookies.txt /var/lib/ytdl/cookies.txt && rm /tmp/cookies.txt'"
	echo "    this is deliberately not tracked in git, it's a live session"
fi

echo "▸ services install done on $(hostname)"
