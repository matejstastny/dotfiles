supervisor=supervise-daemon
datadir="/var/lib/jellyfin"
cachedir="/var/cache/jellyfin"
configdir="/var/lib/jellyfin/config"
logdir="/var/log/jellyfin"
webdir="/usr/share/webapps/jellyfin-web"
ffmpegpath="/usr/lib/jellyfin-ffmpeg/ffmpeg"

# the package default is --nowebclient; caddy fronts the hostname but the tv
# apps also want to hit :8096 on the lan directly, so the web ui stays on
opts=""
