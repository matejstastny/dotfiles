#!/sbin/openrc-run

name="anisette-v3"
description="private SideStore anisette-v3 server"
supervisor=supervise-daemon

command=/usr/bin/docker
command_args="start -a anisette-v3"
respawn_delay=5
respawn_max=0

depend() {
	need docker
}

stop_post() {
	docker stop --time 15 anisette-v3 >/dev/null 2>&1 || true
}
