#!/bin/sh
#@ build the ytdl, share and dash binaries for io. runs on this machine, not on the pi.

set -eu

self="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

command -v pnpm >/dev/null || { echo "prepare: pnpm is not installed" >&2; exit 1; }
command -v go >/dev/null || { echo "prepare: go is not installed" >&2; exit 1; }

echo "▸ ytdl: building the ui"
cd "$self/web"
pnpm install --frozen-lockfile --silent
pnpm build >/dev/null

# the ui is embedded into the binary, so io never needs node or a static root
echo "▸ ytdl: building the binary for linux/arm64"
cd "$self/server"
mkdir -p "$self/build"
CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -trimpath -ldflags="-s -w" -o "$self/build/ytdl" .

echo "  $(du -h "$self/build/ytdl" | cut -f1) at build/ytdl"

echo "▸ share: building the ui"
cd "$self/share-web"
pnpm install --frozen-lockfile --silent
pnpm build >/dev/null

echo "▸ share: building the binary for linux/arm64"
cd "$self/share-server"
CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -trimpath -ldflags="-s -w" -o "$self/build/share" .

echo "  $(du -h "$self/build/share" | cut -f1) at build/share"

echo "▸ dash: building the ui"
cd "$self/dash-web"
pnpm install --frozen-lockfile --silent
pnpm build >/dev/null

echo "▸ dash: building the binary for linux/arm64"
cd "$self/dash-server"
CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -trimpath -ldflags="-s -w" -o "$self/build/dash" .

echo "  $(du -h "$self/build/dash" | cut -f1) at build/dash"

# the catalog is embedded as a fallback but also shipped as a file, so a new
# service can be added by editing /etc/dash/catalog.json and restarting
cp "$self/dash-server/catalog.json" "$self/build/dash-catalog.json"
