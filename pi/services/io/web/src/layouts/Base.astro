---
import "../styles/app.css";

interface Props {
    title: string;
    page: "download" | "recent";
}

const { title, page } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="color-scheme" content="dark" />
        <meta name="robots" content="noindex, nofollow" />
        <title>{title}</title>
        <link
            rel="preload"
            href="/fonts/maple-400.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
    </head>
    <body>
        <main class="shell">
            <header class="top">
                <span class="mark">
                    <span class="glyph">◒</span> yt <span class="host">· io</span>
                </span>
                <nav>
                    <a href="/" aria-current={page === "download" ? "page" : undefined}>download</a>
                    <a href="/recent/" aria-current={page === "recent" ? "page" : undefined}>
                        recent
                    </a>
                </nav>
            </header>
            <slot />
            <footer>yt-dlp + ffmpeg on io · tailnet only</footer>
        </main>
    </body>
</html>
