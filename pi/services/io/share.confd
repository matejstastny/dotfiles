# the service only ever listens on loopback; caddy is what the tailnet talks to
export SHARE_LISTEN=127.0.0.1:8091

export SHARE_DIR=/var/lib/share/files

# a rolling window, not a real cache: oldest file is dropped once a new one
# would push the count over this
export SHARE_MAX_FILES=10
export SHARE_MAX_FILESIZE_GB=5

output_log=/var/log/share/share.log
error_log=/var/log/share/share.err
