# the service only ever listens on loopback; caddy is what the tailnet talks to
export DASH_LISTEN=127.0.0.1:8092

export DASH_VM_URL=http://127.0.0.1:8428
export DASH_VM_RETENTION=90d

# which hosts and services the page describes. everything on the page except
# this file is measured, so adding a service is an edit here plus a restart,
# not a rebuild.
export DASH_CATALOG=/etc/dash/catalog.json

# sparkline window and resolution
export DASH_LOOKBACK=3h
export DASH_STEP=2m

# node-exporter is scraped every 15s, so there is nothing to gain from asking
# victoria-metrics more often than that
export DASH_METRICS_EVERY=15s
export DASH_PROBE_EVERY=20s
export DASH_SERVICE_EVERY=20s
export DASH_PROBE_TIMEOUT=2s

# service apis the page reads detail out of. all loopback except adguard,
# which lives on thebe and is reached over the tailnet.
export DASH_TRANSMISSION_URL=http://127.0.0.1:9091/transmission/rpc
export DASH_JELLYFIN_URL=http://127.0.0.1:8096
export DASH_YTDL_URL=http://127.0.0.1:8090
export DASH_SHARE_URL=http://127.0.0.1:8091
export DASH_ADGUARD_URL=http://thebe:3000
export DASH_ADGUARD_USER=elara

export DASH_TAILSCALE_BIN=/usr/bin/tailscale

# adguard has no api tokens, only the web login, so its password is a live
# secret and lives outside git. install prints how to create this file.
# the file holds a plain KEY=value the way caddy.env does, so the re-export
# is what actually puts it in the daemon's environment. -r rather than -f
# because the file is root-only and this conf.d is also sourced by an
# unprivileged `rc-service dash status`, which must not fail over a secret it
# has no business reading.
if [ -r /etc/dash/dash.env ]; then
	. /etc/dash/dash.env
	export DASH_ADGUARD_PASS
fi

output_log=/var/log/dash/dash.log
error_log=/var/log/dash/dash.err
