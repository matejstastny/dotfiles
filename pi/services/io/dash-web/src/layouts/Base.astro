---
import "../styles/app.css";

interface Props {
    title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="color-scheme" content="dark" />
        <meta name="robots" content="noindex, nofollow" />
        <title>{title}</title>
        <link
            rel="preload"
            href="/fonts/maple-400.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
        <link
            rel="preload"
            href="/fonts/maple-600.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
    </head>
    <body>
        <slot />
    </body>
</html>
