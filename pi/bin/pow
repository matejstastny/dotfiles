#!/bin/sh

# power and thermal monitor. by default it pins every core first, so a weak
# supply can be told apart from a hot case; -m just watches.

set -eu

self=${0##*/}
usage() {
	cat <<-EOF
		$self - raspberry pi power and thermal monitor

		usage: $self [-m|-h]
		  -b          benchmark, synthetic load on CPU
		  -h          this help
	EOF
}

mode=monitor
while [ "$#" -gt 0 ]; do
	case $1 in
	-b | --bench) mode=burn ;;
	-h | --help)
		usage
		exit 0
		;;
	*)
		printf '%s: unknown option %s\n' "$self" "$1" >&2
		usage >&2
		exit 2
		;;
	esac
	shift
done

command -v stty >/dev/null || {
	printf 'stty is required\n' >&2
	exit 1
}
command -v vcgencmd >/dev/null || {
	printf 'vcgencmd is required\n' >&2
	exit 1
}

# the throttle bits are readable by the video group on most images, so only
# reach for sudo when the plain call actually fails
vc=vcgencmd
if ! vcgencmd get_throttled >/dev/null 2>&1; then
	command -v sudo >/dev/null || {
		printf 'vcgencmd needs root and sudo is missing\n' >&2
		exit 1
	}
	sudo -v
	sudo -n vcgencmd get_throttled >/dev/null 2>&1 ||
		{
			printf 'cannot read throttle flags even with sudo\n' >&2
			exit 1
		}
	vc='sudo -n vcgencmd'
fi

# uses the same per-host colours as the pi shell
host_palette=${XDG_CONFIG_HOME:-"$HOME/.config"}/zsh/host.zsh
moon_value() {
	if [ -r "$host_palette" ]; then
		sed -n "s/^$1=\"\(.*\)\"$/\1/p" "$host_palette" | head -n 1
	fi
}
moon_name=$(moon_value MOON_NAME)
moon_glyph=$(moon_value MOON_GLYPH)
moon_accent=$(moon_value MOON_ACCENT)
moon_bright=$(moon_value MOON_BRIGHT)
moon_alt=$(moon_value MOON_ALT)
moon_dim=$(moon_value MOON_DIM)
moon_name=${moon_name:-$(hostname)}
moon_glyph=${moon_glyph:-●}
moon_accent=${moon_accent:-#9b6bc9}
moon_bright=${moon_bright:-#c9a8e8}
moon_alt=${moon_alt:-#a855c9}
moon_dim=${moon_dim:-#8a7a9e}

colour() {
	hex=${1#\#}
	r=${hex%"${hex#??}"}
	rest=${hex#??}
	g=${rest%"${rest#??}"}
	b=${rest#??}
	printf '\033[38;2;%d;%d;%dm' "0x$r" "0x$g" "0x$b"
}

esc=$(printf '\033')
reset="${esc}[0m"
bold="${esc}[1m"
nl='
'

c_accent=$(colour "$moon_accent")
c_bright=$(colour "$moon_bright")
c_alt=$(colour "$moon_alt")
c_dim=$(colour "$moon_dim")
c_muted=$(colour '#6b7089')
c_good=$(colour '#a6e3a1')
c_warn=$(colour '#f9e2af')
c_bad=$(colour '#f38ba8')

glyph_fill='━'
glyph_void='·'

# sysfs first: no root, no fork per sample
temp_path=/sys/class/thermal/thermal_zone0/temp
clk_path=/sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq
clk_max_path=/sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_max_freq
temp_src=vcgencmd
[ -r "$temp_path" ] && temp_src=sysfs
clk_src=vcgencmd
[ -r "$clk_path" ] && clk_src=sysfs

clk_ceiling=0
if [ -r "$clk_max_path" ]; then
	read -r clk_ceiling <"$clk_max_path" || clk_ceiling=0
	clk_ceiling=$((clk_ceiling / 1000))
fi
if [ "$clk_ceiling" -le 0 ]; then
	clk_ceiling=$(vcgencmd get_config arm_freq 2>/dev/null || printf 'arm_freq=1500')
	clk_ceiling=${clk_ceiling#*=}
	case $clk_ceiling in '' | *[!0-9]*) clk_ceiling=1500 ;; esac
fi

cores=$(getconf _NPROCESSORS_ONLN 2>/dev/null || nproc)
noun=cores
[ "$cores" -ne 1 ] || noun=core
if [ "$mode" = monitor ]; then
	title='power monitor'
	verdict_title='monitor result'
	ran='while monitoring'
else
	title='power burn-in'
	verdict_title='burn-in result'
	ran='while the load ran'
fi
loadavg='--'
load_pids=''
started_at=$(date +%s)
now=$started_at
samples=0
temp_total=0
temp_max=0
temp_d=0
clk_mhz=0
clk_low=0
clk_high=0
volts='--'
flags=0
live=0
seen_undervoltage=0
seen_cap=0
seen_throttle=0
seen_soft=0
hist=''
hist_n=0
rule=''
rule_span=0
quit=0
terminal_ready=0

stop_load() {
	[ -z "$load_pids" ] || {
		kill $load_pids 2>/dev/null || true
		wait $load_pids 2>/dev/null || true
	}
	load_pids=''
}

restore_terminal() {
	[ "$terminal_ready" -eq 1 ] || return 0
	terminal_ready=0
	stty "$saved_stty" 2>/dev/null || true
	printf '\033[?2026l\033[?25h\033[?1049l'
}

cleanup() {
	stop_load
	restore_terminal
}
trap cleanup EXIT HUP INT TERM

repeat() {
	rep=''
	i=0
	while [ "$i" -lt "$2" ]; do
		rep="$rep$1"
		i=$((i + 1))
	done
}

say() { out="$out$1$nl"; }
padl() {
	repeat ' ' $((${#1} >= $2 ? 0 : $2 - ${#1}))
	padded="$rep$1"
}
padr() {
	repeat ' ' $((${#1} >= $2 ? 0 : $2 - ${#1}))
	padded="$1$rep"
}
pad2() { if [ "$1" -lt 10 ]; then p2="0$1"; else p2="$1"; fi; }

# a bar of $3 cells showing $1 out of $2, fill in colour $4
bar() {
	fill=0
	[ "$2" -le 0 ] || fill=$(($1 * $3 / $2))
	[ "$fill" -le "$3" ] || fill=$3
	[ "$fill" -ge 0 ] || fill=0
	repeat "$glyph_fill" "$fill"
	graph="$4$rep"
	repeat "$glyph_void" $(($3 - fill))
	graph="$graph$c_dim$rep$reset"
}

block() {
	case $1 in
	0) blk='▁' ;; 1) blk='▂' ;; 2) blk='▃' ;; 3) blk='▄' ;;
	4) blk='▅' ;; 5) blk='▆' ;; 6) blk='▇' ;; *) blk='█' ;;
	esac
}

heat() {
	if [ "$1" -ge 800 ]; then
		heat_colour=$c_bad
	elif [ "$1" -ge 700 ]; then
		heat_colour=$c_warn
	else
		heat_colour=$c_good
	fi
}

# one column of the throttle grid: name on top, current state under it
flag_cell() {
	if [ $((flags & $2)) -ne 0 ]; then
		state=ACTIVE
		state_colour=$c_bad
	elif [ "$3" -ne 0 ]; then
		state=seen
		state_colour=$c_warn
	else
		state=clear
		state_colour=$c_good
	fi
	padr "$1" "$cell"
	names="$names$padded"
	padr "$state" "$cell"
	states="$states${state_colour}${padded}${reset}"
}

sample() {
	now=$(date +%s)

	if [ "$temp_src" = sysfs ]; then
		read -r raw <"$temp_path" || raw=0
		temp_d=$((raw / 100))
	else
		raw=$($vc measure_temp 2>/dev/null || printf "temp=0.0'C")
		raw=${raw#*=}
		raw=${raw%\'*}
		temp_d=$((${raw%%.*} * 10 + ${raw#*.}))
	fi

	if [ "$clk_src" = sysfs ]; then
		read -r raw <"$clk_path" || raw=0
		clk_mhz=$((raw / 1000))
	else
		raw=$($vc measure_clock arm 2>/dev/null || printf 'x=0')
		clk_mhz=$((${raw#*=} / 1000000))
	fi

	raw=$($vc measure_volts core 2>/dev/null) || raw=''
	case $raw in *=*V)
		volts=${raw#*=}
		volts=${volts%V}
		;;
	*) volts='--' ;; esac

	raw=$($vc get_throttled 2>/dev/null) || raw='throttled=0x0'
	flags=$((${raw#*=}))

	if [ -r /proc/loadavg ]; then read -r loadavg _rest </proc/loadavg || loadavg='--'; fi

	samples=$((samples + 1))
	temp_total=$((temp_total + temp_d))
	[ "$temp_d" -le "$temp_max" ] || temp_max=$temp_d
	[ "$clk_high" -ge "$clk_mhz" ] || clk_high=$clk_mhz
	if [ "$clk_low" -eq 0 ] || [ "$clk_mhz" -lt "$clk_low" ]; then clk_low=$clk_mhz; fi

	live=$((flags & 0x0f))
	[ $((flags & 0x1)) -eq 0 ] || seen_undervoltage=1
	[ $((flags & 0x2)) -eq 0 ] || seen_cap=1
	[ $((flags & 0x4)) -eq 0 ] || seen_throttle=1
	[ $((flags & 0x8)) -eq 0 ] || seen_soft=1

	if [ -z "$hist" ]; then hist=$temp_d; else hist="$hist $temp_d"; fi
	hist_n=$((hist_n + 1))
	# 55 is the widest graph the capped layout can ask for
	while [ "$hist_n" -gt 55 ]; do
		hist=${hist#* }
		hist_n=$((hist_n - 1))
	done
}

put() {
	row=$((row + 1))
	frame="$frame${esc}[${row};1H$1${esc}[K"
}

# no screen clear anywhere: every line ends in erase-to-eol, the frame ends in
# erase-below, and the whole thing goes out as one write inside a synchronised
# update. that is what keeps it from flashing the way a full redraw does.
draw() {
	size=$(stty size 2>/dev/null || printf '24 80')
	rows=${size%% *}
	cols=${size##* }
	case $rows in '' | *[!0-9]*) rows=24 ;; esac
	case $cols in '' | *[!0-9]*) cols=80 ;; esac

	frame="${esc}[?2026h"
	row=0

	if [ "$cols" -lt 64 ] || [ "$rows" -lt 17 ]; then
		put "${c_warn}pow needs at least 64x17, this is ${cols}x${rows}${reset}"
		printf '%s' "$frame${esc}[J${esc}[?2026l"
		return
	fi

	span=$((cols - 4))
	[ "$span" -le 76 ] || span=76
	width=$((span - 21))

	if [ "$span" -ne "$rule_span" ]; then
		repeat '─' "$span"
		rule=$rep
		rule_span=$span
	fi

	elapsed=$((now - started_at))
	pad2 $((elapsed / 3600))
	timer=$p2
	pad2 $(((elapsed % 3600) / 60))
	timer="$timer:$p2"
	pad2 $((elapsed % 60))
	timer="$timer:$p2"

	heat "$temp_d"
	temp_colour=$heat_colour
	average=0
	[ "$samples" -eq 0 ] || average=$((temp_total / samples))

	put ''
	gap=$((span - 12 - ${#moon_name} - ${#title}))
	repeat ' ' $((gap >= 1 ? gap : 1))
	put "  ${c_accent}${moon_glyph}${reset} ${bold}${c_bright}${moon_name}${reset}  ${c_alt}${title}${reset}${rep}${c_muted}${timer}${reset}"
	put "  ${c_dim}${rule}${reset}"
	put ''

	# thermal
	bar $((temp_d / 10 - 30)) 60 "$width" "$temp_colour"
	padr temp 9
	label=$padded
	padl "$((temp_d / 10)).$((temp_d % 10))" 6
	put "  ${c_alt}${label}${reset}${graph}  ${temp_colour}${padded}${reset} ${c_muted}°C${reset}"

	# take the tail that fits without dropping it, so narrowing is not lossy
	shown=$hist
	shown_n=$hist_n
	while [ "$shown_n" -gt "$width" ]; do
		shown=${shown#* }
		shown_n=$((shown_n - 1))
	done
	spark=''
	spark_colour=''
	for value in $shown; do
		level=$(((value / 10 - 30) * 8 / 60))
		[ "$level" -ge 0 ] || level=0
		[ "$level" -le 7 ] || level=7
		block "$level"
		heat "$value"
		if [ "$heat_colour" != "$spark_colour" ]; then
			spark="$spark$heat_colour"
			spark_colour=$heat_colour
		fi
		spark="$spark$blk"
	done
	repeat ' ' 9
	put "  $rep$spark$reset"
	put "  $rep${c_muted}avg $((average / 10))    peak $((temp_max / 10))    warn 70    soft limit 85${reset}"
	put ''

	# power and clock
	bar "$clk_mhz" "$clk_ceiling" "$width" "$c_bright"
	padr clock 9
	label=$padded
	padl "$clk_mhz" 6
	put "  ${c_alt}${label}${reset}${graph}  ${c_bright}${padded}${reset} ${c_muted}MHz${reset}"
	padr core 9
	label=$padded
	padl "$volts" 6
	if [ "$mode" = monitor ]; then
		load_note="load ${loadavg} of ${cores} ${noun}"
	else
		load_note="holding ${cores} ${noun} at 100%"
	fi
	put "  ${c_alt}${label}${reset}${c_bright}${padded}${reset} ${c_muted}V     ${load_note}${reset}"
	put ''

	# throttle flags, current state over the whole run
	cell=$(((span - 9) / 4))
	[ "$cell" -ge 11 ] || cell=11
	repeat ' ' 9
	indent=$rep
	names=''
	states=''
	flag_cell undervolt 0x1 "$seen_undervoltage"
	flag_cell 'freq cap' 0x2 "$seen_cap"
	flag_cell throttled 0x4 "$seen_throttle"
	flag_cell 'soft temp' 0x8 "$seen_soft"
	padr limits 9
	put "  ${c_alt}${padded}${reset}${c_muted}${names}${reset}"
	put "  $indent$states"
	put ''

	if [ "$live" -ne 0 ]; then
		verdict="${c_bad}limit active now${reset}"
		verdict_len=16
	elif [ "$seen_undervoltage$seen_cap$seen_throttle$seen_soft" != 0000 ]; then
		verdict="${c_warn}limit seen during run${reset}"
		verdict_len=21
	else
		verdict="${c_good}clean so far${reset}"
		verdict_len=12
	fi
	put "  ${c_dim}${rule}${reset}"
	tail_text="$samples samples"
	repeat ' ' $((span - 12 - verdict_len - ${#tail_text} >= 1 ? span - 12 - verdict_len - ${#tail_text} : 1))
	put "  $verdict${c_muted}    ${tail_text}${reset}${rep}${c_bright}q${reset} ${c_dim}finish${reset}"

	printf '%s' "$frame${esc}[J${esc}[?2026l"
}

# printed on the normal screen once the alt screen is gone, so the verdict
# stays in the scrollback instead of disappearing with the ui
results() {
	average=0
	[ "$samples" -eq 0 ] || average=$((temp_total / samples))
	elapsed=$((now - started_at))
	pad2 $((elapsed / 3600))
	timer=$p2
	pad2 $(((elapsed % 3600) / 60))
	timer="$timer:$p2"
	pad2 $((elapsed % 60))
	timer="$timer:$p2"
	repeat '─' 60
	rule=$rep

	out=''
	say ''
	say "  ${c_accent}${moon_glyph}${reset} ${bold}${c_bright}${moon_name}${reset}  ${c_alt}${verdict_title}${reset}"
	say "  ${c_dim}${rule}${reset}"
	say ''
	padr runtime 14
	say "  ${c_muted}${padded}${reset}${timer}  over ${samples} samples"
	padr temperature 14
	say "  ${c_muted}${padded}${reset}$((temp_d / 10))°C now, $((average / 10))°C average, ${c_bright}$((temp_max / 10))°C peak${reset}"
	padr clock 14
	if [ "$mode" = monitor ]; then clock_note='MHz seen'; else clock_note='MHz under load'; fi
	say "  ${c_muted}${padded}${reset}${clk_low}-${clk_high} ${clock_note}, ${clk_ceiling} MHz ceiling"
	say ''
	if [ "$seen_undervoltage$seen_cap$seen_throttle$seen_soft" = 0000 ]; then
		say "  ${c_good}${bold}pass${reset}${c_good}    no power or thermal limit appeared ${ran}${reset}"
	else
		say "  ${c_warn}${bold}check${reset}${c_warn}   a limit appeared ${ran}${reset}"
		[ "$seen_undervoltage" -eq 0 ] || say "          ${c_warn}undervoltage, the supply sagged${reset}"
		[ "$seen_cap" -eq 0 ] || say "          ${c_warn}arm frequency capped${reset}"
		[ "$seen_throttle" -eq 0 ] || say "          ${c_warn}thermal throttling${reset}"
		[ "$seen_soft" -eq 0 ] || say "          ${c_warn}soft temperature limit at 85°C${reset}"
	fi
	say ''
	say "  ${c_dim}get_throttled bits 16-19 are historical since boot, so this${reset}"
	say "  ${c_dim}only counts limits that turned up after pow started.${reset}"
	say ''
	printf '%s' "$out"
}

if [ "$mode" = burn ]; then
	for _core in $(seq 1 "$cores"); do
		(while :; do :; done) &
		load_pids="$load_pids $!"
	done
fi

saved_stty=$(stty -g)
# min 0 time 10 makes one read both the frame clock and the keypress wait: it
# returns the moment a key lands, or after a second with nothing
stty -echo -icanon min 0 time 10
printf '\033[?1049h\033[?25l\033[2J'
terminal_ready=1

while [ "$quit" -eq 0 ]; do
	sample
	draw
	tick=$now
	while [ "$quit" -eq 0 ] && [ "$now" -eq "$tick" ]; do
		key=$(dd bs=1 count=1 2>/dev/null || true)
		case ${key:-} in q | Q) quit=1 ;; esac
		now=$(date +%s)
	done
done

stop_load
restore_terminal
results
