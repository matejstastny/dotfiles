#!/bin/sh
# fans status/schedule: same night window as leds, but the fan only cuts out
# quiet, it kicks back in on its own if the SoC gets hot. day hours run it flat
# out regardless of temperature. gpio direction/value are not preserved across
# reboots either, so boot-check has to re-apply state itself.

set -eu

GPIO_PIN=${FANS_GPIO:-17}
ON_C=${FANS_ON_C:-70}
OFF_C=${FANS_OFF_C:-65}

case "$0" in
*/*) self="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/$(basename -- "$0")" ;;
*) self="$(command -v "$0")" ;;
esac

gpio_path="/sys/class/gpio/gpio${GPIO_PIN}"

require_gpio() {
	if [ ! -d "$gpio_path" ]; then
		echo "$GPIO_PIN" >/sys/class/gpio/export
		i=0
		while [ ! -e "$gpio_path/direction" ] && [ "$i" -lt 10 ]; do
			sleep 1
			i=$((i + 1))
		done
	fi
	[ -e "$gpio_path/direction" ] || {
		echo "gpio${GPIO_PIN} did not appear under /sys/class/gpio after export" >&2
		exit 1
	}
	echo out >"$gpio_path/direction"
}

fans_on() {
	require_gpio
	echo 1 >"$gpio_path/value"
}

fans_off() {
	require_gpio
	echo 0 >"$gpio_path/value"
}

fans_state() {
	if [ -r "$gpio_path/value" ] && [ "$(cat "$gpio_path/value")" = 1 ]; then
		echo on
	else
		echo off
	fi
}

read_temp_c() {
	temp_path=/sys/class/thermal/thermal_zone0/temp
	[ -r "$temp_path" ] || return 1
	echo $(($(cat "$temp_path") / 1000))
}

fans_status() {
	temp_c=$(read_temp_c) || temp_c='?'
	printf 'gpio%-3s state=%-3s temp=%s°C\n' "$GPIO_PIN" "$(fans_state)" "$temp_c"
}

is_night() {
	hour=$(date +%H)
	case $hour in
	23 | 00 | 01 | 02 | 03 | 04 | 05 | 06) return 0 ;;
	*) return 1 ;;
	esac
}

# called from cron every couple of minutes: day is always full speed, night
# only spins the fan up past $ON_C and drops it again below $OFF_C, the gap
# in between is a dead band so it doesn't chatter right at the line
fans_check() {
	if ! is_night; then
		fans_on
		return
	fi

	temp_c=$(read_temp_c) || {
		echo "cannot read thermal_zone0, leaving fan state as-is" >&2
		exit 1
	}

	if [ "$temp_c" -ge "$ON_C" ]; then
		fans_on
	elif [ "$temp_c" -le "$OFF_C" ]; then
		fans_off
	fi
}

fans_install() {
	echo "▸ installing control script to /usr/local/bin/fans"
	install -o root -g root -m 755 "$self" /usr/local/bin/fans

	echo "▸ installing boot-time check (via openrc local service)"
	cat >/etc/local.d/fans.start <<-'EOF'
		#!/bin/sh
		/usr/local/bin/fans check
	EOF
	chmod 755 /etc/local.d/fans.start
	rc-update add local default

	echo "▸ making sure crond is available"
	if [ ! -x /etc/init.d/crond ]; then
		apk add busybox-initscripts
	fi
	rc-update add crond default
	rc-service crond start || rc-service crond restart

	echo "▸ installing schedule (day: always on, night: on >=${ON_C}C, off <=${OFF_C}C)"
	crontab_file=/etc/crontabs/root
	marker='# fans: night threshold schedule (managed by fans install)'
	if ! grep -qF "$marker" "$crontab_file" 2>/dev/null; then
		{
			echo "$marker"
			echo '*/2 * * * * /usr/local/bin/fans check'
		} >>"$crontab_file"
	fi

	echo "▸ fans install done on $(hostname)"
}

cmd=${1:-status}

case "$cmd" in
on | off | check | install)
	if [ "$(id -u)" -ne 0 ]; then
		exec sudo "$self" "$cmd"
	fi
	;;
esac

case "$cmd" in
on) fans_on ;;
off) fans_off ;;
status) fans_status ;;
state) fans_state ;;
check) fans_check ;;
install) fans_install ;;
*)
	echo "usage: ${0##*/} [on|off|status|check|install]" >&2
	exit 2
	;;
esac
