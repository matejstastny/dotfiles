#!/bin/sh
# leds status/schedule: triggers reset to hardware defaults on every reboot,
# so boot-check has to re-apply "off" itself if it wakes up mid-schedule

set -eu

case "$0" in
*/*) self="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/$(basename -- "$0")" ;;
*) self="$(command -v "$0")" ;;
esac

resolve_led() {
	for name in $1; do
		if [ -d "/sys/class/leds/$name" ]; then
			echo "$name"
			return 0
		fi
	done
	return 1
}

ACT=$(resolve_led "led0 ACT act" || true)
PWR=$(resolve_led "led1 PWR pwr" || true)

require_leds() {
	if [ -z "${ACT}${PWR}" ]; then
		echo "no LEDs found under /sys/class/leds (checked led0/ACT, led1/PWR)" >&2
		exit 1
	fi
}

leds_off() {
	require_leds
	for led in $ACT $PWR; do
		echo none >"/sys/class/leds/$led/trigger"
		echo 0 >"/sys/class/leds/$led/brightness"
	done
}

leds_on() {
	require_leds
	[ -n "$ACT" ] && echo mmc0 >"/sys/class/leds/$ACT/trigger"
	[ -n "$PWR" ] && echo default-on >"/sys/class/leds/$PWR/trigger"
}

leds_status() {
	require_leds
	for led in $ACT $PWR; do
		trigger=$(sed -n 's/.*\[\(.*\)\].*/\1/p' "/sys/class/leds/$led/trigger")
		brightness=$(cat "/sys/class/leds/$led/brightness")
		printf '%-4s trigger=%-10s brightness=%s\n' "$led" "$trigger" "$brightness"
	done
}

leds_state() {
	require_leds
	for led in $ACT $PWR; do
		trigger=$(sed -n 's/.*\[\(.*\)\].*/\1/p' "/sys/class/leds/$led/trigger")
		if [ "$trigger" != none ]; then
			echo on
			return
		fi
	done
	echo off
}

leds_boot_check() {
	hour=$(date +%H)
	case $hour in
	23 | 00 | 01 | 02 | 03 | 04 | 05 | 06)
		leds_off
		;;
	esac
}

leds_install() {
	echo "▸ installing control script to /usr/local/bin/leds"
	install -o root -g root -m 755 "$self" /usr/local/bin/leds

	echo "▸ installing boot-time check (via openrc local service)"
	cat >/etc/local.d/leds.start <<-'EOF'
		#!/bin/sh
		/usr/local/bin/leds boot-check
	EOF
	chmod 755 /etc/local.d/leds.start
	rc-update add local default

	echo "▸ making sure crond is available"
	if [ ! -x /etc/init.d/crond ]; then
		apk add busybox-initscripts
	fi
	rc-update add crond default
	rc-service crond start || rc-service crond restart

	echo "▸ installing night schedule (off 23:00, on 07:00)"
	crontab_file=/etc/crontabs/root
	marker='# leds: night schedule (managed by leds install)'
	if ! grep -qF "$marker" "$crontab_file" 2>/dev/null; then
		{
			echo "$marker"
			echo '0 23 * * * /usr/local/bin/leds off'
			echo '0 7 * * * /usr/local/bin/leds on'
		} >>"$crontab_file"
	fi

	echo "▸ leds install done on $(hostname)"
}

cmd=${1:-status}

case "$cmd" in
on | off | boot-check | install)
	if [ "$(id -u)" -ne 0 ]; then
		exec sudo "$self" "$cmd"
	fi
	;;
esac

case "$cmd" in
on) leds_on ;;
off) leds_off ;;
status) leds_status ;;
state) leds_state ;;
boot-check) leds_boot_check ;;
install) leds_install ;;
*)
	echo "usage: ${0##*/} [on|off|status|install]" >&2
	exit 2
	;;
esac
