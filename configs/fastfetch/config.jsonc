// elara handcrafted <3
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": { "type": "none" },

    "display": {
        "separator": "  ",
        "color": { "separator": "38;2;61;61;92" },
        "percent": {
            "type": 11,
            "color": {
                "green": "38;2;122;191;196",
                "yellow": "38;2;196;168;122",
                "red": "38;2;196;122;184"
            }
        },
        "bar": {
            "border": { "left": "", "right": "  " },
            "char": { "elapsed": "━", "total": "━" },
            "width": 10
        },
        "constants": ["──────────────────────────────"]
    },

    "modules": [
        "break",

        {
            "type": "title",
            "key": " ",
            "format": "{#38;2;196;122;184}{user-name}{#38;2;61;61;92}  ·  {#38;2;122;191;196}{host-name}"
        },
        {
            "type": "custom",
            "format": "{#38;2;61;61;92}  {$1}  {#38;2;196;122;184}✦"
        },
        "break",

        {
            "type": "os",
            "keyWidth": 11,
            "key": "{#38;2;196;122;184}{icon} {#38;2;120;120;200}os"
        },
        {
            "type": "kernel",
            "keyWidth": 11,
            "key": "{#38;2;196;122;184}{icon} {#38;2;120;120;200}kernel"
        },
        {
            "type": "uptime",
            "keyWidth": 11,
            "key": "{#38;2;196;122;184}{icon} {#38;2;120;120;200}uptime"
        },
        {
            "type": "packages",
            "keyWidth": 11,
            "key": "{#38;2;196;122;184}{icon} {#38;2;120;120;200}pkgs"
        },
        "break",

        {
            "type": "shell",
            "keyWidth": 11,
            "key": "{#38;2;196;122;184}{icon} {#38;2;120;120;200}shell"
        },
        {
            "type": "wm",
            "keyWidth": 11,
            "key": "{#38;2;196;122;184}{icon} {#38;2;120;120;200}wm"
        },
        {
            "type": "terminal",
            "keyWidth": 11,
            "key": "{#38;2;196;122;184}{icon} {#38;2;120;120;200}term"
        },
        {
            "type": "terminalfont",
            "keyWidth": 11,
            "key": "{#38;2;196;122;184}{icon} {#38;2;120;120;200}font"
        },
        "break",

        {
            "type": "cpu",
            "keyWidth": 11,
            "key": "{#38;2;196;122;184}{icon} {#38;2;120;120;200}cpu"
        },
        {
            "type": "gpu",
            "keyWidth": 11,
            "key": "{#38;2;196;122;184}{icon} {#38;2;120;120;200}gpu"
        },
        {
            "type": "memory",
            "keyWidth": 11,
            "key": "{#38;2;196;122;184}{icon} {#38;2;120;120;200}ram"
        },
        {
            "type": "swap",
            "keyWidth": 11,
            "key": "{#38;2;196;122;184}{icon} {#38;2;120;120;200}swap"
        },
        {
            "type": "disk",
            "keyWidth": 11,
            "key": "{#38;2;196;122;184}{icon} {#38;2;120;120;200}disk",
            "folders": "/"
        },
        "break",

        {
            "type": "custom",
            "format": "{#38;2;61;61;92}  {$1}  {#38;2;196;122;184}✦"
        },
        "break",

        { "type": "colors", "symbol": "circle", "paddingLeft": 2 },
        "break"
    ]
}
