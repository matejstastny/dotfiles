{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
    "display": {
        "key": {
            "width": 10
        },
        "size": {
            "binaryPrefix": "jedec"
        },
        "separator": ""
    },
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/ascii.txt",
        "width": 1,
        "height": 10
    },
    "modules": [
        "break",
        {
            "type": "os",
            "key": "os",
            "keyColor": "#c47a9b",
            "format": "{name}"
        },
        {
            "type": "kernel",
            "key": "ker",
            "keyColor": "#7c5cbf"
        },
        {
            "type": "packages",
            "key": "pkgs",
            "keyColor": "#9b8ab0"
        },
        {
            "type": "shell",
            "key": "sh",
            "keyColor": "#9b8ab0",
            "format": "{pretty-name}"
        },
        {
            "type": "wm",
            "key": "wm",
            "keyColor": "#7c5cbf",
            "format": "{pretty-name}"
        },
        {
            "type": "uptime",
            "key": "up",
            "keyColor": "#9b8ab0"
        },
        {
            "type": "cpu",
            "key": "cpu",
            "keyColor": "#c47a9b",
            "format": "{name}"
        },
        {
            "type": "memory",
            "key": "ram",
            "keyColor": "#7c5cbf",
            "format": "{used} / {total}"
        },
        {
            "type": "disk",
            "key": "disk",
            "keyColor": "#9b8ab0",
            "folders": [
                "/"
            ],
            "format": "{size-used} / {size-total}"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[33m \u001b[32m \u001b[34m \u001b[31m \u001b[36m \u001b[35m \u001b[37m \u001b[97m "
        }
    ]
}
